<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext (HTTP) traffic ONLY to development hosts.
  Production traffic should use HTTPS.

  Add more hosts here if you run the backend on a custom LAN IP.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator loopback to host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Common private LAN ranges (physical-device testing) -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
    <!-- Fallback: still allow cleartext during development.
         Remove this block for production builds. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
